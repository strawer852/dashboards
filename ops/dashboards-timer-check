#!/usr/bin/env bash
# Alarm when the refresh timers have stopped firing.
#
# Why this exists. Until 4 September 2026 a dead timer announced itself: the
# windows fetched every series on every firing, so refresh.log filled up daily
# and a silent log meant something was wrong. The calendar gate then made a
# quiet log the NORMAL state -- most windowed runs now stop at a database query
# because nothing is due. That is the intended behaviour and it removed the
# accidental heartbeat along with the noise.
#
# So this looks at the mechanism rather than at the log, which is the same
# lesson bigricebowl-backup-check was written for: a script reports its own
# failure, but nothing reports its absence.
#
# WHAT IT CANNOT CATCH ON ITS OWN. It runs as a user timer, so it cannot detect
# the user manager being gone entirely -- in that case this does not run either.
# Nor can it report a dead box, a dead network or a full disk, because all of
# those produce silence, and silence is indistinguishable from a healthy quiet
# day when every alert originates on the machine being watched.
#
# That is what HEALTHCHECK_URL is for, and it is the third turn of the same
# screw this repo has already been bitten by twice. A script reports its own
# failure but not its absence, so bigricebowl-backup-check watches the artefact
# instead of the script -- but only if the box is alive to run it. A dead-man's
# switch inverts the logic one level further: this pings an EXTERNAL service on
# success, and that service alarms when the pings stop. The absence of a signal
# becomes the alarm, and the watching happens somewhere else.
#
# It is dormant until HEALTHCHECK_URL is set in ~/dashboards/.env -- any service
# taking a ping URL will do (healthchecks.io, Cronitor, Better Uptime). Unset,
# nothing is sent and nothing breaks. Do NOT point it at anything running on
# this VPS: a dead-man's switch hosted on the machine it watches is not one.
set -uo pipefail

ROOT="$HOME/dashboards"
LOG="$ROOT/logs/timer-check.log"
STATUS="$ROOT/data/v1/status.json"
MAX_AGE_HOURS=${MAX_AGE_HOURS:-26}     # the sweep is daily; 26h allows for drift
TS=$(date -u "+%Y-%m-%d %H:%M:%SZ")
mkdir -p "$ROOT/logs"

# Telegram, matching bigricebowl-backup-check: this is an ops alarm about the
# machinery, not a pipeline event about data. ntfy would also be wrong here
# because a broken user manager cannot run the thing that would push it.
# shellcheck disable=SC1091
[ -f "$HOME/bigricebowl/.env" ] && source "$HOME/bigricebowl/.env"
# HEALTHCHECK_URL lives with the pipeline's own secrets.
# shellcheck disable=SC1091
[ -f "$ROOT/.env" ] && source "$ROOT/.env"

# The ping must never be able to change this check's outcome: a monitoring
# call that can fail the job it monitors is worse than no monitoring. Every
# failure here is logged and swallowed.
ping_deadman() {
    local suffix="$1" body="$2"
    [ -n "${HEALTHCHECK_URL:-}" ] || return 0
    curl -fsS -m 10 --retry 2 -o /dev/null \
         --data-raw "$body" "${HEALTHCHECK_URL}${suffix}" 2>/dev/null \
      || echo "[$TS] CHECK: dead-man ping failed (${suffix:-success})" >> "$LOG"
    return 0
}

PROBLEMS=()

note() { PROBLEMS+=("$1"); }

# 1. Lingering. Without it the user manager exits at logout and every user timer
#    stops, which is the single fault that would silence everything at once.
if ! loginctl show-user "$USER" -p Linger --value 2>/dev/null | grep -q '^yes$'; then
    note "lingering is OFF for $USER -- user timers stop at logout"
fi

# 2/3. Every timer armed, and no unit sitting in failed.
#
# The watch list is read from the repo's own systemd/ directory rather than
# typed here. It was typed here, and within a day it was wrong: a timer added
# for the CPI and PPI releases was invisible to the check that exists to notice
# a timer going quiet. A list of units maintained in two places is a list that
# is correct once.
#
# Deliberately NOT `list-units --state=active`: asking the machine which timers
# it is running and then checking those are running is a tautology. The repo
# says what should exist; the machine is asked whether it does.
EXPECTED=()
for f in "$ROOT"/systemd/*.timer; do
    [ -e "$f" ] || continue
    EXPECTED+=("$(basename "$f" .timer)")
done
EXPECTED+=(dashboards-push)
if [ "${#EXPECTED[@]}" -lt 2 ]; then
    note "no timer units found in $ROOT/systemd -- the watch list is empty"
fi

for t in "${EXPECTED[@]}"; do
    if ! systemctl --user is-enabled --quiet "$t.timer" 2>/dev/null; then
        note "$t.timer is not enabled"
    fi
    if ! systemctl --user is-active --quiet "$t.timer"; then
        note "$t.timer is not active"
    fi
    if systemctl --user is-failed --quiet "$t.service"; then
        note "$t.service is in a failed state"
    fi
done

# 4. The sweep is the real heartbeat: it runs daily with no --releases, so the
#    calendar gate never applies to it and it is the one job that must fire
#    every day whatever the release calendar says.
LAST=$(systemctl --user show -p LastTriggerUSec --value macro-refresh-sweep.timer 2>/dev/null)
if [ -z "$LAST" ] || [ "$LAST" = "n/a" ]; then
    note "macro-refresh-sweep.timer has never fired"
else
    AGE_H=$(python3 - "$LAST" <<'PY'
import subprocess, sys, datetime
raw = sys.argv[1]
try:
    secs = int(subprocess.run(["date", "-d", raw, "+%s"], capture_output=True,
                              text=True, check=True).stdout.strip())
    now = int(datetime.datetime.now().timestamp())
    print((now - secs) // 3600)
except Exception:
    print(-1)
PY
)
    if [ "$AGE_H" -lt 0 ]; then
        note "could not read when the sweep last fired (raw: $LAST)"
    elif [ "$AGE_H" -gt "$MAX_AGE_HOURS" ]; then
        note "the daily sweep last fired ${AGE_H}h ago (limit ${MAX_AGE_HOURS}h)"
    fi
fi

# 5. And that a run actually did something, not merely that systemd started it.
if [ ! -f "$STATUS" ]; then
    note "status.json is missing -- no refresh has ever written one"
else
    SAGE=$(python3 - "$STATUS" <<'PY'
import json, sys, datetime
try:
    d = json.load(open(sys.argv[1]))
    t = datetime.datetime.fromisoformat(d["last_run"].replace("Z", "+00:00"))
    now = datetime.datetime.now(datetime.timezone.utc)
    print(int((now - t).total_seconds() // 3600))
except Exception:
    print(-1)
PY
)
    if [ "$SAGE" -lt 0 ]; then
        note "status.json is unreadable or has no last_run"
    elif [ "$SAGE" -gt "$MAX_AGE_HOURS" ]; then
        note "the last refresh of any kind was ${SAGE}h ago (limit ${MAX_AGE_HOURS}h)"
    fi
fi

if [ ${#PROBLEMS[@]} -eq 0 ]; then
    echo "[$TS] OK: timers armed, sweep recent, status fresh" >> "$LOG"
    # Only on success. A ping sent regardless would tell the external service
    # everything is fine while this script was reporting that it is not.
    ping_deadman "" "ok: timers armed, sweep recent, status fresh"
    exit 0
fi

BODY="🚨 Dashboards timer check:"
for p in "${PROBLEMS[@]}"; do
    BODY="$BODY"$'\n'"  • $p"
    echo "[$TS] CHECK: $p" >> "$LOG"
done
BODY="$BODY"$'\n\n'"Inspect with: systemctl --user list-timers 'macro-refresh-*'"

if [ -n "${TELEGRAM_BOT_TOKEN:-}" ] && [ -n "${TELEGRAM_CHAT_ID:-}" ]; then
    curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
        -d chat_id="${TELEGRAM_CHAT_ID}" -d text="$BODY" > /dev/null \
        || echo "[$TS] CHECK: telegram push failed" >> "$LOG"
else
    echo "[$TS] CHECK: no telegram credentials; alarm not sent" >> "$LOG"
fi

# Tell the external service too, rather than waiting for the grace period to
# expire. If Telegram is what is broken, this is the path that still works.
ping_deadman "/fail" "$BODY"
exit 1
