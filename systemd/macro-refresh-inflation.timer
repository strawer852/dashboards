[Unit]
Description=CPI and PPI poll, 08:30 ET embargo

[Timer]
# CPI and PPI carry the same 08:30 ET embargo as the Employment Situation, so
# this is the employment window shifted five minutes. Until it existed the only
# thing that fetched either release was the 01:40 ET sweep -- which runs seven
# hours BEFORE the embargo, so both inflation dashboards would have sat a full
# day stale after every release. That is the same defect the employment timer
# was built to fix, simply never extended to the dashboards added afterwards.
#
# The offset is deliberate. tools/refresh.sh takes a non-blocking lock, so two
# timers firing in the same minute means one exits without polling. Employment
# holds minutes 35/45/55 and 05/15/25/35/45/55; this takes 40/50 and
# 00/10/20/30/40/50, so the two never contend.
OnCalendar=Mon..Fri *-*-* 08:40/10:00 America/New_York
OnCalendar=Mon..Fri *-*-* 09..12:00/10:00 America/New_York

# Cheap to run on a day with no release: refresh.py checks macro_release_dates
# first and stops at a database query when nothing is due, before any FRED call.
Persistent=true
AccuracySec=30s

[Install]
WantedBy=timers.target
